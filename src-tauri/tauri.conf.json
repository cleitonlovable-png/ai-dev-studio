{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Dev Studio",
  "version": "0.1.0",
  "identifier": "com.aidevstudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Dev Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3M0YwRENDODFFMURGRTEKUldUaDMrR0J6QTAvUitkSDFyRUkzdURNbTJwSVFXRzUvQTdLNnhSeUxvcUJTZ09SSHVUa2R5TUYK",
      "endpoints": [
        "https://github.com/cleitonlovable-png/ai-dev-studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}